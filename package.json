{
  "name": "typewheel",
  "productName": "TypeWheel",
  "version": "1.0.0",
  "description": "Radial quick-text wheel for Windows",
  "author": "Jacob Abramson",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jabramson.typewheel",
    "productName": "TypeWheel",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TypeWheel-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TypeWheel-Portable-${version}.exe"
    }
  }
}
